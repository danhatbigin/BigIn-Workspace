{
  "name": "bigin-employee-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "motion:docs": "tsx scripts/motion-docs.ts",
    "docs:check": "tsx scripts/motion-docs.ts --check",
    "check": "npm run typecheck && npm run test && npm run docs:check"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
