{
  "name": "bigin-employee-workspace",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:desktop",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/desktop-live-smoke.mjs",
    "motion:docs": "tsx scripts/motion-docs.ts",
    "docs:check": "tsx scripts/motion-docs.ts --check",
    "check": "npm run typecheck && npm run test && npm run docs:check && npm run tokens:check",
    "tokens:audit": "tsx scripts/token-audit.ts",
    "tokens:check": "tsx scripts/token-audit.ts --check && tsx scripts/token-docs.ts --check",
    "tokens:docs": "tsx scripts/token-docs.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:windows": "npm run build && node scripts/package-windows.mjs",
    "build:windows:smoke": "npm run build && node scripts/package-windows.mjs --smoke",
    "ci": "npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
